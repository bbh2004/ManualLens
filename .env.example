GROQ_API_KEY=your_groq_api_key_here

# Storage paths (relative to project root)
STORAGE_DIR=storage
PDF_DIR=storage/pdfs
PAGE_IMAGES_DIR=storage/page_images
SQLITE_DB_PATH=storage/db/metadata.sqlite
CHROMA_DIR=storage/db/chroma
QDRANT_DIR=storage/db/qdrant

# Processing settings
MAX_PDF_SIZE_MB=50
CHUNK_SIZE_TOKENS=200
CHUNK_OVERLAP_TOKENS=20
OCR_TEXT_THRESHOLD=50

# Retrieval settings
TEXT_TOP_K=5
VISUAL_TOP_K=3
RRF_K=60
ENABLE_VISUAL_INDEXING=true

# GraphRAG (Part 2 Feature 1)
ENABLE_GRAPHRAG=true
GRAPH_BUILD_ON_INGEST=true
GRAPH_STORE_TYPE=auto
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
GRAPH_TOP_K=5

# Modal GPU Acceleration for ColPali
USE_MODAL=true
MODAL_APP_NAME=manuallens-colpali
MODAL_GPU=T4
MODAL_BATCH_SIZE=2
MODAL_PARALLEL_ENABLED=true
MODAL_PARALLEL_THRESHOLD=50
MODAL_MAX_CONTAINERS=4

# LLM settings
GROQ_MODEL=llama-3.1-8b-instant
LLM_MAX_TOKENS=1500
LLM_TEMPERATURE=0.1

# Server
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173

