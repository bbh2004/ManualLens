GROQ_API_KEY=your_groq_api_key_here

# Storage paths (relative to project root)
STORAGE_DIR=storage
PDF_DIR=storage/pdfs
PAGE_IMAGES_DIR=storage/page_images
SQLITE_DB_PATH=storage/db/metadata.sqlite
CHROMA_DIR=storage/db/chroma
QDRANT_DIR=storage/db/qdrant

# Processing settings
MAX_PDF_SIZE_MB=50
CHUNK_SIZE_TOKENS=200
CHUNK_OVERLAP_TOKENS=20
OCR_TEXT_THRESHOLD=50

# Retrieval settings
TEXT_TOP_K=5
VISUAL_TOP_K=3
RRF_K=60
ENABLE_VISUAL_INDEXING=true

# LLM settings
GROQ_MODEL=llama-3.1-8b-instant
LLM_MAX_TOKENS=1500
LLM_TEMPERATURE=0.1

# Server
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173

